<Window x:Class="Stock_Trade.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
        xmlns:local="clr-namespace:Stock_Trade"
        xmlns:xctk="http://xceed.com"
        mc:Ignorable="d"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="ATK Trading" Height="550" Width="900"
        Style="{StaticResource MaterialDesignWindow}"
        Background="#000000">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="50"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="50"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Grid.Column="0" 
                Height="50"
                Grid.ColumnSpan="4" Background="#101010">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="379*"/>
                    <ColumnDefinition Width="171*"/>
                    <ColumnDefinition Width="50"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#101010">
                    <Grid>
                        <TextBox x:Name="txtTicker" 
                                 Foreground="White"
                                 Margin="10,0,0,0"
                                 FontSize="20"
                                 VerticalAlignment="Center" 
                                 Text="VCB.VN" KeyDown="txtTicker_KeyDown"/>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Background="#101010">
                    <Button Content="Charts" FontSize="20" Style="{StaticResource MaterialDesignFlatButton}" Foreground="White"/>
                </Border>

                <Border Grid.Column="4" Background="#101010">
                    <Grid>
                        <Button Style="{StaticResource MaterialDesignFlatButton}" Foreground="White">
                            <materialDesign:PackIcon Kind="Gear"></materialDesign:PackIcon>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.Column="0">
            <Border.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="Black"/>
                    <GradientStop Color="#FF1A1A1A" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="200"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0">
                    <StackPanel>
                        <Button Style="{StaticResource MaterialDesignFlatButton}" Foreground="White">
                            <materialDesign:PackIcon Kind="HandBackLeft"></materialDesign:PackIcon>
                        </Button>

                        <Button Style="{StaticResource MaterialDesignFlatButton}" Foreground="White">
                            <materialDesign:PackIcon Kind="pen"></materialDesign:PackIcon>
                        </Button>

                        <Button Style="{StaticResource MaterialDesignFlatButton}" Foreground="White">
                            <materialDesign:PackIcon Kind="ScanHelper"></materialDesign:PackIcon>
                        </Button>

                        <Button Style="{StaticResource MaterialDesignFlatButton}" Foreground="White">
                            <materialDesign:PackIcon Kind="Text"></materialDesign:PackIcon>
                        </Button>
                    </StackPanel>
                </Border>
                <Border Grid.Row="1"></Border>
                <Border Grid.Row="2"></Border>
            </Grid>
        </Border>

        <lvc:CartesianChart Series="{Binding SeriesCollection}" Zoom="Xy"
                            Grid.Row="1" Grid.Column="1" Margin="5,5,5,5">
        </lvc:CartesianChart>

        <Border Grid.Column="2" Grid.Row="1">
            <Border.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="Black"/>
                    <GradientStop Color="#FF1A1A1A" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="100"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="80"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#222024" Margin="6" CornerRadius="10">
                    <StackPanel Margin="10,0,0,0">
                        <Label Content="VCB.VN"
                               x:Name="txtName"
                               Foreground="White"
                               FontSize="25"/>

                        <Label Content="Mode: Finance"
                               Foreground="#C8ABDE"
                               FontSize="9"/>
                        <Label Content="Time Mode: 1H"
                               Foreground="#C8ABDE"
                               FontSize="9"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" BorderBrush="White">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="#222024" Margin="6" CornerRadius="10">
                                <StackPanel>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="30"/>
                                            <RowDefinition Height="30"/>
                                        </Grid.RowDefinitions>

                                        <Border Grid.Row="0">
                                            <Label Content="Order Entry" 
                                                   Foreground="White"
                                                   FontSize="20"
                                                   Margin="10,0,0,0"/>
                                        </Border>

                                        <Border Grid.Row="1">
                                            <StackPanel>

                                                <ComboBox Height="25" Foreground="White"
                                                          materialDesign:HintAssist.Hint="Order Types"
                                                          Margin="10,0,10,0">
                                                    <ComboBox.ItemContainerStyle>
                                                        <Style TargetType="ComboBoxItem">
                                                            <Setter Property="Foreground" Value="#222024"/>
                                                            <Setter Property="Cursor" Value="Hand"/>
                                                        </Style>
                                                    </ComboBox.ItemContainerStyle>
                                                    <ComboBoxItem Content="Market Buy"/>
                                                    <ComboBoxItem Content="Market Sell"/>
                                                    <ComboBoxItem Content="Limit Buy"/>
                                                    <ComboBoxItem Content="Limit Sell"/>
                                                    <ComboBoxItem Content="Stop Buy"/>
                                                    <ComboBoxItem Content="Stop Sell"/>
                                                    <ComboBoxItem Content="Trailing Stop Buy"/>
                                                    <ComboBoxItem Content="Trailing Stop Sell"/>
                                                </ComboBox>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Row="2">
                                            <UserControl Height="25" Margin="10,0,10,0">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0">
                                                        <TextBox Text="0.0000" Foreground="Gray"/>
                                                    </Border>
                                                </Grid>
                                            </UserControl>
                                        </Border>

                                        <Border Grid.Row="3">
                                            <ComboBox Height="25" Foreground="White"
                                                                  materialDesign:HintAssist.Hint="Time in Force"
                                                                  Margin="10,0,10,0">
                                                <ComboBox.ItemContainerStyle>
                                                    <Style TargetType="ComboBoxItem">
                                                        <Setter Property="Foreground" Value="#222024"/>
                                                        <Setter Property="Cursor" Value="Hand"/>
                                                    </Style>
                                                </ComboBox.ItemContainerStyle>
                                                <ComboBoxItem Content="GTC"/>
                                                <ComboBoxItem Content="IOC"/>
                                                <ComboBoxItem Content="FOK"/>
                                                <ComboBoxItem Content="GTD"/>
                                            </ComboBox>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="1" Background="#222024" Margin="6" CornerRadius="10">
                                <StackPanel>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <Border Grid.Row="0">
                                            <Label Content="Pricing and Trigger" 
                                                   Foreground="White"
                                                   FontSize="20"
                                                   Margin="10,0,0,0"/>
                                        </Border>

                                        <Border Grid.Row="1">
                                            <StackPanel Margin="10,0,10,0">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="25"/>
                                                        <RowDefinition Height="25"/>
                                                    </Grid.RowDefinitions>

                                                    <Border Grid.Row="0">
                                                        <Label Content="Price"
                                                               Foreground="White"
                                                               FontSize="10"/>
                                                    </Border>

                                                    <Border Grid.Row="1">
                                                        <TextBox Text="0.0000" Foreground="Gray" Margin="5,0,5,0"/>
                                                    </Border>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Row="2">
                                            <StackPanel Margin="10,0,10,0">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="25"/>
                                                        <RowDefinition Height="25"/>
                                                    </Grid.RowDefinitions>

                                                    <Border Grid.Row="0">
                                                        <Label Content="Trigger Price"
                                                               Foreground="White"
                                                               FontSize="10"/>
                                                    </Border>

                                                    <Border Grid.Row="1">
                                                        <TextBox Text="0.0000" Foreground="Gray" Margin="5,0,5,0"/>
                                                    </Border>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Row="3">
                                            <StackPanel Margin="10,0,10,0">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="25"/>
                                                        <RowDefinition Height="25"/>
                                                    </Grid.RowDefinitions>

                                                    <Border Grid.Row="0">
                                                        <Label Content="Limit Price"
                                                               Foreground="White"
                                                               FontSize="10"/>
                                                    </Border>

                                                    <Border Grid.Row="1">
                                                        <TextBox Text="0.0000" Foreground="Gray" Margin="5,0,5,0"/>
                                                    </Border>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Row="4">
                                            <StackPanel Margin="10,0,10,0">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="25"/>
                                                        <RowDefinition Height="25"/>
                                                    </Grid.RowDefinitions>

                                                    <Border Grid.Row="0">
                                                        <Label Content="Trailing Amount"
                                                               Foreground="White"
                                                               FontSize="10"/>
                                                    </Border>

                                                    <Border Grid.Row="1">
                                                        <TextBox Text="0.0000" Foreground="Gray" Margin="5,0,5,0"/>
                                                    </Border>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Row="5">
                                            <StackPanel Margin="10,0,10,0">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="25"/>
                                                        <RowDefinition Height="25"/>
                                                    </Grid.RowDefinitions>

                                                    <Border Grid.Row="0">
                                                        <Label Content="Use Trailing %"
                                                               Foreground="White"
                                                               FontSize="10"/>
                                                    </Border>

                                                    <Border Grid.Row="1">
                                                        <CheckBox BorderBrush="White" Margin="5,0,5,0"/>
                                                    </Border>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="2" Background="#222024" Margin="6" CornerRadius="10">
                                <StackPanel>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <Border Grid.Row="0">
                                            <Label Content="Protection" 
                                                   Foreground="White"
                                                   FontSize="20"
                                                   Margin="10,0,0,0"/>
                                        </Border>

                                        <Border Grid.Row="1">
                                            <StackPanel Margin="10,0,10,0">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="25"/>
                                                        <RowDefinition Height="25"/>
                                                    </Grid.RowDefinitions>

                                                    <Border Grid.Row="0">
                                                        <Label Content="Take Profit"
                                                               Foreground="White"
                                                               FontSize="10"/>
                                                    </Border>

                                                    <Border Grid.Row="1">
                                                        <TextBox Text="0.0000" Foreground="Gray" Margin="5,0,5,0"/>
                                                    </Border>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Row="2">
                                            <StackPanel Margin="10,0,10,0">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="25"/>
                                                        <RowDefinition Height="25"/>
                                                    </Grid.RowDefinitions>

                                                    <Border Grid.Row="0">
                                                        <Label Content="Stop Loss"
                                                               Foreground="White"
                                                               FontSize="10"/>
                                                    </Border>

                                                    <Border Grid.Row="1">
                                                        <TextBox Text="0.0000" Foreground="Gray" Margin="5,0,5,0"/>
                                                    </Border>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="3" Background="#222024" Margin="6" CornerRadius="10">
                                <StackPanel>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <Border Grid.Row="0">
                                            <Label Content="Execution Option" 
                                                   Foreground="White"
                                                   FontSize="20"
                                                   Margin="10,0,0,0"/>
                                        </Border>

                                        <Border Grid.Row="1">
                                            <StackPanel Margin="10,0,10,0">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Border Grid.Column="0">
                                                        <Label Content="Reduce Only"
                                                               Foreground="White"
                                                               FontSize="10"/>
                                                    </Border>

                                                    <Border Grid.Column="1">
                                                        <CheckBox BorderBrush="White"/>
                                                    </Border>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Row="2">
                                            <StackPanel Margin="10,0,10,0">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Border Grid.Column="0">
                                                        <Label Content="Post Only"
                                                               Foreground="White"
                                                               FontSize="10"/>
                                                    </Border>

                                                    <Border Grid.Column="1">
                                                        <CheckBox BorderBrush="White"/>
                                                    </Border>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </Border>

                <Border Grid.Row="2" Margin="6">
                    <Button Background="#C8ABDE" 
                            Content="Place Order"
                            Foreground="Black"
                            Height="50" FontSize="25"/>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Column="3" Grid.Row="1">
            <Border.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="Black"/>
                    <GradientStop Color="#FF1A1A1A" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="50*"/>
                </Grid.RowDefinitions>
                
                <Border Grid.Row="0">
                    <Button Style="{StaticResource MaterialDesignFlatButton}" Foreground="White">
                        <materialDesign:PackIcon Kind="Table"></materialDesign:PackIcon>
                    </Button>
                </Border>

                <Border Grid.Row="1">
                    <Button Style="{StaticResource MaterialDesignFlatButton}" Foreground="White">
                        <materialDesign:PackIcon Kind="User"></materialDesign:PackIcon>
                    </Button>
                </Border>

                <Border Grid.Row="2">
                    <Button Style="{StaticResource MaterialDesignFlatButton}" Foreground="White">
                        <materialDesign:PackIcon Kind="Clock"></materialDesign:PackIcon>
                    </Button>
                </Border>
            </Grid>
        </Border>



        <Border Grid.Row="2" Grid.Column="0" 
        Grid.ColumnSpan="4" Background="#101010"
                Height="35px">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="50"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0">
                    <Button Style="{StaticResource MaterialDesignFlatButton}" Foreground="White">
                        <materialDesign:PackIcon Kind="Eye"></materialDesign:PackIcon>
                    </Button>
                </Border>

                <Border Grid.Column="1">
                    <ScrollViewer VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Auto">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="btn_1m" Content="1m" Foreground="White" FontSize="15"
                                    Style="{StaticResource MaterialDesignFlatButton}" HorizontalAlignment="Left"></Button>
                            <Button x:Name="btn_2m" Content="2m" Foreground="White" FontSize="15"
                                    Style="{StaticResource MaterialDesignFlatButton}" HorizontalAlignment="Left"></Button>
                            <Button x:Name="btn_5m" Content="5m" Foreground="White" FontSize="15"
                                    Style="{StaticResource MaterialDesignFlatButton}" HorizontalAlignment="Left"></Button>
                            <Button x:Name="btn_15m" Content="15m" Foreground="White" FontSize="15"
                                    Style="{StaticResource MaterialDesignFlatButton}" HorizontalAlignment="Left"></Button>
                            <Button x:Name="btn_30m" Content="30m" Foreground="White" FontSize="15"
                                    Style="{StaticResource MaterialDesignFlatButton}" HorizontalAlignment="Left"></Button>
                            <Button x:Name="btn_1h" Content="1h" Foreground="White" FontSize="15"
                                    Style="{StaticResource MaterialDesignFlatButton}" HorizontalAlignment="Left"></Button>
                            <Button x:Name="btn_2h" Content="2h" Foreground="White" FontSize="15"
                                    Style="{StaticResource MaterialDesignFlatButton}" HorizontalAlignment="Left"></Button>
                            <Button x:Name="btn_4h" Content="4h" Foreground="White" FontSize="15"
                                    Style="{StaticResource MaterialDesignFlatButton}" HorizontalAlignment="Left"></Button>
                            <Button x:Name="btn_12h" Content="12h" Foreground="White" FontSize="15"
                                    Style="{StaticResource MaterialDesignFlatButton}" HorizontalAlignment="Left"></Button>
                            <Button x:Name="btn_1d" Content="1d" Foreground="White" FontSize="15"
                                    Style="{StaticResource MaterialDesignFlatButton}" HorizontalAlignment="Left"></Button>
                            <Button x:Name="btn_2d" Content="2d" Foreground="White" FontSize="15"
                                    Style="{StaticResource MaterialDesignFlatButton}" HorizontalAlignment="Left"></Button>
                            <Button x:Name="btn_3d" Content="3d" Foreground="White" FontSize="15"
                                    Style="{StaticResource MaterialDesignFlatButton}" HorizontalAlignment="Left"></Button>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <Border Grid.Column="2">
                    <Button Style="{StaticResource MaterialDesignFlatButton}" Foreground="White">
                        <Grid>
                            <Label Content="@username" Foreground="White"/>
                        </Grid>
                    </Button>
                </Border>

                <Border Grid.Column="3">
                    <Button Style="{StaticResource MaterialDesignFlatButton}" Foreground="White">
                        <materialDesign:PackIcon Kind="Notifications"></materialDesign:PackIcon>
                    </Button>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
